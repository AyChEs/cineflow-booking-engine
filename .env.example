APP_NAME=CineFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Base de datos ────────────────────────────────────────────────────────────
# Por defecto SQLite (cero configuración, ideal para la demo desplegada).
# Para MySQL: cambia DB_CONNECTION=mysql y descomenta el bloque de abajo.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cineflow
# DB_USERNAME=cineflow
# DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Correo ────────────────────────────────────────────────────────────────────
# MAIL_MAILER=log escribe los correos en storage/logs (no se envían).
# MAIL_MAILER=smtp funciona en local/Docker con cualquier SMTP (Brevo, Gmail…).
# MAIL_MAILER=brevo usa la API HTTP de Brevo en vez de SMTP — necesario en
# plataformas (Render free tier incluida) que bloquean los puertos SMTP salientes;
# solo necesita BREVO_API_KEY, no host/puerto/usuario/contraseña.
MAIL_MAILER=log
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="entradas@cineflow.test"
MAIL_FROM_NAME="${APP_NAME}"
BREVO_API_KEY=

VITE_APP_NAME="${APP_NAME}"

# ── Stripe (pago real en modo test) ──────────────────────────────────────────
# Si dejas STRIPE_SECRET vacío, el checkout usa el pago SIMULADO integrado.
# Consigue claves test en https://dashboard.stripe.com/test/apikeys
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_CURRENCY=eur

# ── TMDB (cartelera en vivo, opcional) ───────────────────────────────────────
# Sin clave, la app usa un seeder demo con películas de ejemplo.
MOVIES_API_ENABLED=false
MOVIES_API_BASE_URL=https://api.themoviedb.org/3
MOVIES_API_TIMEOUT=8
TMDB_API_KEY=
TMDB_LANGUAGE=es-ES
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500

# ── Yelmo Cines (cartelera real, opcional) ───────────────────────────────────
# Con YELMO_ENABLED=true la cartelera espeja los títulos reales de Yelmo
# (endpoint JSON público) emparejados con TMDB. Requiere TMDB para los pósters.
YELMO_ENABLED=false
YELMO_CITIES=madrid,barcelona,valencia,sevilla,bilbao

# ── Monthly cartelera refresh (optional) ─────────────────────────────────────
# Secret for /internal/sync-cartelera, meant to be hit by an external
# scheduler (e.g. a monthly cron-job.org job) on platforms with no cron daemon.
CARTELERA_SYNC_TOKEN=
